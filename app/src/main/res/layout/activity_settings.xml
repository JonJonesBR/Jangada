<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_bg"
    android:orientation="vertical">

    <!-- Altura mínima em vez de fixa: com fonte grande o título não corta. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/settings_back"
            style="@style/BarButton"
            android:text="@string/terminal_home_arrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/setup_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/HomeSection"
                android:layout_marginTop="0dp"
                android:text="@string/settings_mode" />

            <RadioGroup
                android:id="@+id/settings_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/mode_simple"
                    style="@style/SettingsOption"
                    android:text="@string/settings_mode_simple" />

                <RadioButton
                    android:id="@+id/mode_pro"
                    style="@style/SettingsOption"
                    android:text="@string/settings_mode_pro" />
            </RadioGroup>

            <!-- Aparência: tema do app, tema do terminal e tamanho do texto do chat. -->
            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_appearance" />

            <RadioGroup
                android:id="@+id/settings_app_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/theme_system" style="@style/SettingsOption" android:text="@string/theme_system" />
                <RadioButton android:id="@+id/theme_light" style="@style/SettingsOption" android:text="@string/theme_light" />
                <RadioButton android:id="@+id/theme_dark" style="@style/SettingsOption" android:text="@string/theme_dark" />
            </RadioGroup>

            <Button
                android:id="@+id/settings_terminal_theme"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <Button
                android:id="@+id/settings_chat_text"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <!-- Chat: digitação, permissões, avisos, atraso de silêncio, modelo, esforço e padrões dos agentes. -->
            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_chat" />

            <Switch
                android:id="@+id/settings_enter_sends"
                style="@style/SettingsOption"
                android:text="@string/settings_enter_sends" />

            <RadioGroup
                android:id="@+id/settings_permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/permissions_ask"
                    style="@style/SettingsOption"
                    android:text="@string/settings_permissions_ask" />

                <RadioButton
                    android:id="@+id/permissions_auto"
                    style="@style/SettingsOption"
                    android:text="@string/settings_permissions_auto" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_permissions_note"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/settings_remember_approve_all"
                style="@style/SettingsOption"
                android:text="@string/settings_remember_approve_all" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_remember_approve_all_desc"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/settings_haptic"
                style="@style/SettingsOption"
                android:text="@string/settings_haptic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_haptic_hint"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/settings_chat_stall"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_model" />

            <RadioGroup
                android:id="@+id/settings_model_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/model_default"
                    style="@style/SettingsOption"
                    android:text="@string/chat_model_default" />

                <RadioButton
                    android:id="@+id/model_opus"
                    style="@style/SettingsOption"
                    android:text="Opus" />

                <RadioButton
                    android:id="@+id/model_sonnet"
                    style="@style/SettingsOption"
                    android:text="Sonnet" />

                <RadioButton
                    android:id="@+id/model_haiku"
                    style="@style/SettingsOption"
                    android:text="Haiku" />
            </RadioGroup>

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_effort" />

            <RadioGroup
                android:id="@+id/settings_effort_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/effort_default" style="@style/SettingsOption" android:text="@string/chat_effort_default" />
                <RadioButton android:id="@+id/effort_low" style="@style/SettingsOption" android:text="@string/effort_low" />
                <RadioButton android:id="@+id/effort_medium" style="@style/SettingsOption" android:text="@string/effort_medium" />
                <RadioButton android:id="@+id/effort_high" style="@style/SettingsOption" android:text="@string/effort_high" />
                <RadioButton android:id="@+id/effort_xhigh" style="@style/SettingsOption" android:text="@string/effort_xhigh" />
                <RadioButton android:id="@+id/effort_max" style="@style/SettingsOption" android:text="@string/effort_max" />
            </RadioGroup>

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_agent_defaults" />

            <Button
                android:id="@+id/settings_agent_defaults"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_agent_defaults_hint"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/settings_other_agents"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/settings_agent_tips"
                style="@style/SettingsOption"
                android:text="@string/settings_agent_tips" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_agent_tips_hint"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <!-- Agente chamando agente (jangada-call): desligado por padrão; escrita só com o Aprovar tudo. -->
            <Switch
                android:id="@+id/settings_agent_calls"
                style="@style/SettingsOption"
                android:text="@string/settings_agent_calls" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_agent_calls_desc"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/settings_call_roles"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <!-- Memória e desempenho: quantos agentes rodam, quando os parados dormem e a compactação da conversa. -->
            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_memory" />

            <Button
                android:id="@+id/settings_max_agents"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_max_agents_desc"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_sleep_after" />

            <Button
                android:id="@+id/settings_sleep_after"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_sleep_after_hint"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <TextView
                style="@style/HomeSection"
                android:text="@string/auto_compact_title" />

            <Button
                android:id="@+id/settings_auto_compact"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_auto_compact_desc"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <!-- Code Mode do Claude (experimental): vale para conversas novas; cada trabalho pode ter o seu. -->
            <TextView
                style="@style/HomeSection"
                android:text="@string/code_mode_title" />

            <Button
                android:id="@+id/settings_code_mode"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/code_mode_settings_desc"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <!-- Concisão das respostas: entra no bloco de instruções de todos os agentes, inclusive o terminal. -->
            <TextView
                style="@style/HomeSection"
                android:text="@string/conciseness_title" />

            <Button
                android:id="@+id/settings_conciseness"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_conciseness_desc"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <!-- Economia do OpenCode: preset próprio do app, só nos chats do OpenCode; o opencode.json não muda. -->
            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_opencode_economy" />

            <Button
                android:id="@+id/settings_opencode_economy"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_opencode_economy_desc"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <!-- Avançado: CPU, tela, teclas extras e contas dos agentes. -->
            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_advanced" />

            <Switch
                android:id="@+id/settings_cpu_awake"
                style="@style/SettingsOption"
                android:text="@string/settings_cpu_awake" />

            <Switch
                android:id="@+id/settings_screen_on"
                style="@style/SettingsOption"
                android:text="@string/settings_screen_on" />

            <Switch
                android:id="@+id/settings_extra_keys"
                style="@style/SettingsOption"
                android:text="@string/settings_extra_keys" />

            <Button
                android:id="@+id/settings_api_keys"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/keys_title"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_linux" />

            <TextView
                android:id="@+id/settings_linux_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/setup_muted_text"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/settings_auto_clean"
                style="@style/SettingsOption"
                android:text="@string/settings_auto_clean" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_auto_clean_hint"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/settings_cleanup"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_cleanup"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <Button
                android:id="@+id/settings_repair"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_repair"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <Button
                android:id="@+id/settings_reinstall"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_reinstall"
                android:textAllCaps="false"
                android:textColor="@color/setup_error_text" />

            <TextView
                style="@style/HomeSection"
                android:text="@string/settings_backup" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_intro"
                android:textColor="@color/setup_muted_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/settings_backup_export"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_export"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <Button
                android:id="@+id/settings_backup_import"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_import"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />

            <Button
                android:id="@+id/settings_about"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/about_title"
                android:textAllCaps="false"
                android:minHeight="48dp"
                android:textColor="@color/accent_text" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
