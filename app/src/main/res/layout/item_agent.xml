<?xml version="1.0" encoding="utf-8"?>
<!--
    Cartão compacto do agente: cabeçalho (nome, situação e ⋯), linha de limites, progresso/erro da tarefa
    e só os botões do dia a dia (Conversar/Instalar/Abrir e Atualizar). Fornecedor, descrição, nota, site,
    o chat/terminal alternativo, Nova conversa, reinstalar e desinstalar ficam no ⋯ (HomeActivity.showAgentMenu).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Cabeçalho: nome, situação abaixo dele e o ⋯ à direita (área de toque de 48 dp). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="simple"
                android:ellipsize="end"
                android:hyphenationFrequency="none"
                android:maxLines="2"
                android:textColor="@color/setup_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/chip_bg"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/setup_muted_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/agent_more"
            android:gravity="center"
            android:text="⋯"
            android:textColor="@color/setup_muted_text"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Limites do plano (agentes que os informam): uma linha pequena, em destaque a partir de 80%. -->
    <TextView
        android:id="@+id/agent_limits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/setup_muted_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/task_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/key_active"
        android:visibility="gone" />

    <TextView
        android:id="@+id/task_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textColor="@color/setup_muted_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/task_cancel"
        style="@style/CardTextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="4dp"
        android:minHeight="48dp"
        android:text="@string/task_cancel"
        android:textColor="@color/accent_text"
        android:visibility="gone" />

    <TextView
        android:id="@+id/task_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/setup_error_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/task_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/task_retry"
            style="@style/CardTextButton"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textColor="@color/accent_text"
            android:text="@string/task_retry" />

        <Button
            android:id="@+id/task_terminal"
            style="@style/CardTextButton"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textColor="@color/accent_text"
            android:text="@string/task_terminal" />

        <Button
            android:id="@+id/task_details"
            style="@style/CardTextButton"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textColor="@color/accent_text"
            android:text="@string/task_details" />
    </LinearLayout>

    <!-- Botões do dia a dia: a ação principal (Conversar, Instalar ou Abrir) e Atualizar, quando há versão nova. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:backgroundTint="@color/key_active"
            android:minWidth="112dp"
            android:textAllCaps="false"
            android:textColor="@color/setup_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/update"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="4dp"
            android:text="@string/agent_update"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
